{
  "name": "classroom-space",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --import tsx server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:api": "node --import tsx server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "setup": "tsx scripts/setup.ts",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "demo": "tsx scripts/demo.ts",
    "backup": "tsx scripts/backup.ts",
    "files:cleanup": "tsx scripts/cleanup.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "jszip": "^3.10.2",
    "lucide-react": "^1.69.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
